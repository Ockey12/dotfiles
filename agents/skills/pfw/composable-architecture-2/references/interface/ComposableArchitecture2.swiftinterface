/// A named value produced by a feature.
///
/// > Tip: This is the ComposableArchitecture equivalent to SwiftUI's `PreferenceKey` protocol.
///
/// A feature with multiple children automatically combines its values for a given preference into a
/// single value visible to its ancestors.
public protocol FeaturePreferenceKey<Value> {

    /// The type of value produced by this preference.
    associatedtype Value : Equatable

    /// The default value of the preference.
    static var defaultValue: Self.Value { get }

    /// Combines a sequence of values by modifying the previously-accumulated value with the result of
    /// a closure that provides the next value.
    ///
    /// This method receives its values in feature-tree order. Conceptually, this combines the
    /// preference value from one tree with that of its next sibling.
    ///
    /// - Parameters:
    ///   - value: The value accumulated through previous calls to this method. The implementation
    ///     should modify this value.
    ///   - nextValue: A closure that returns the next value in the sequence.
    static func reduce(value: inout Self.Value, nextValue: () -> Self.Value)
}

/// A type that represents part of your app's business logic and provides modifiers that you use to
/// configure features.
///
/// Use the ``Feature()`` macro on a structure to synthesize a conformance of this protocol.
///
/// > Tip: This is complementary to SwiftUI's `View` protocol: where `View` describes a feature's
/// > UI, `FeatureProtocol` describes its business logic.
public protocol FeatureProtocol<State, Action> {

    /// The domain specific state of the feature.
    associatedtype State = Void

    /// The domain specific actions of the feature.
    associatedtype Action = Never

    /// The content and behavior of the feature.
    ///
    /// This type alias provides sugar over ``FeatureProtocol`` that progressively conceals the
    /// ``State`` and ``Action`` associated types so that you can define ``body`` in terms of
    /// `some Feature` instead of `some FeatureProtocol<State, Action>`.
    typealias Feature = ComposableArchitecture2.FeatureProtocol<Self.State, Self.Action>

    /// The type of feature representing the body of this feature.
    associatedtype Body

    /// The content and behavior of the feature.
    ///
    /// When you implement a custom feature, you must implement a computed `body` property to provide
    /// the content for your feature. Return a feature that's composed of built-in features that
    /// ComposableArchitecture provides, plus other composite features that you've already defined:
    ///
    /// ```swift
    /// @Feature struct MyFeature {
    ///   struct State {
    ///     var count = 0
    ///   }
    ///   enum Action {
    ///     case incrementButtonTapped
    ///   }
    ///   var body: some Feature {
    ///     Update { state, action in
    ///       switch action {
    ///       case .incrementButtonTapped:
    ///         state.count += 1
    ///       }
    ///     }
    ///   }
    /// }
    /// ```
    @ComposableArchitecture2.FeatureBuilder<Self.State, Self.Action> var body: Self.Body { get }

    static func _mountFeature(feature: ComposableArchitecture2._GraphValue<Self>, inputs: ComposableArchitecture2._FeatureInputs<Self.State, Self.Action>, core: some ComposableArchitecture2._Core<Self.State, Self.Action>)

    static func _routeAction(action: Self.Action, feature: ComposableArchitecture2._GraphValue<Self>, inputs: ComposableArchitecture2._FeatureInputs<Self.State, Self.Action>, core: some ComposableArchitecture2._Core<Self.State, Self.Action>)

    func _isIdentical(to other: Self) -> Bool
}

extension FeatureProtocol where Self.Body == Never {

    public var body: Never { get }
}

