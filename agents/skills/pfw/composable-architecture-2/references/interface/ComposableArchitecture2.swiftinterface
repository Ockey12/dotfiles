/// A custom parameter attribute that constructs features using a result builder context.
///
/// > Tip: This is the ComposableArchitecture equivalent to SwiftUI's `ViewBuilder`, except it
/// > builds and composes your app's business logic, not its UI.
///
/// This parameter attribute is implicitly applied to ``FeatureProtocol/body`` and
/// ``FeatureModifier/body(content:)``, allowing you to build features declaratively using
/// statements:
///
/// ```swift
/// var body: some Feature {
///   Scope(\.home, action: \.home) {
///     Home()
///   }
///   Scope(\.settings, action: \.settings) {
///     Settings()
///   }
/// }
/// ```
///
/// You can explicitly apply ``FeatureBuilder`` to introduce a builder context to a helper function.
@resultBuilder public enum FeatureBuilder<State, Action> {

    /// Builds an empty feature from a block containing no statements.
    public static func buildBlock() -> ComposableArchitecture2.EmptyFeature<State, Action>

    /// Produces content for a conditional statement in a multi-statement closure when the condition
    /// is true.
    public static func buildEither<First, Second>(first component: First) -> ComposableArchitecture2.FeatureBuilder<State, Action>._ConditionalFeature<First, Second> where State == First.State, Action == First.Action, First : ComposableArchitecture2.FeatureProtocol, Second : ComposableArchitecture2.FeatureProtocol, First.Action == Second.Action, First.State == Second.State

    /// Produces content for a conditional statement in a multi-statement closure when the condition
    /// is false.
    public static func buildEither<First, Second>(second component: Second) -> ComposableArchitecture2.FeatureBuilder<State, Action>._ConditionalFeature<First, Second> where State == First.State, Action == First.Action, First : ComposableArchitecture2.FeatureProtocol, Second : ComposableArchitecture2.FeatureProtocol, First.Action == Second.Action, First.State == Second.State

    /// Produces an optional feature for conditional statements in multi-statement closures that's
    /// only visible when the condition evaluates to true.
    public static func buildOptional<F>(_ component: F?) -> F? where State == F.State, Action == F.Action, F : ComposableArchitecture2.FeatureProtocol

    /// Builds an expression within the builder.
    public static func buildExpression<F>(_ expression: F) -> F where State == F.State, Action == F.Action, F : ComposableArchitecture2.FeatureProtocol

    /// Processes feature content for a conditional compiler-control statement that performs an
    /// availability check.
    public static func buildLimitedAvailability(_ component: some ComposableArchitecture2.FeatureProtocol<State, Action>) -> ComposableArchitecture2.AnyFeature<State, Action>

    /// Passes a single feature written as a child feature through unmodified.
    public static func buildPartialBlock<F>(first: F) -> F where State == F.State, Action == F.Action, F : ComposableArchitecture2.FeatureProtocol

    /// Accumulates multiple child features into a single feature.
    public static func buildPartialBlock(accumulated: some ComposableArchitecture2.FeatureProtocol<State, Action>, next: some ComposableArchitecture2.FeatureProtocol<State, Action>) -> some ComposableArchitecture2.FeatureProtocol<State, Action>


    public struct _ConditionalFeature<First, Second> : ComposableArchitecture2.FeatureProtocol where State == First.State, Action == First.Action, First : ComposableArchitecture2.FeatureProtocol, Second : ComposableArchitecture2.FeatureProtocol, First.Action == Second.Action, First.State == Second.State {

        public var first: First? { get }

        public var second: Second? { get }

        public static func _mountFeature(feature: ComposableArchitecture2._GraphValue<ComposableArchitecture2.FeatureBuilder<State, Action>._ConditionalFeature<First, Second>>, inputs: ComposableArchitecture2._FeatureInputs<First.State, First.Action>, core: some ComposableArchitecture2._Core<State, Action>)

        public static func _routeAction(action: Action, feature: ComposableArchitecture2._GraphValue<ComposableArchitecture2.FeatureBuilder<State, Action>._ConditionalFeature<First, Second>>, inputs: ComposableArchitecture2._FeatureInputs<First.State, First.Action>, core: some ComposableArchitecture2._Core<State, Action>)

        public func _isIdentical(to other: ComposableArchitecture2.FeatureBuilder<State, Action>._ConditionalFeature<First, Second>) -> Bool
    }
}

