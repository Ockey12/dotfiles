}

extension Optional : DebugSnapshots.DebugSnapshotConvertible where Wrapped : DebugSnapshots.DebugSnapshotConvertible {

    public static func _debugSnapshot(_ value: Wrapped?, visitor: inout DebugSnapshots._DebugSnapshotVisitor) -> Wrapped.DebugSnapshot?
}

